    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <group android:translateY="960">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M480,-320 L280,-520 l56,-58 l104,104 v-326 h80 v326 l104,-104 l56,58 L480,-320 Z M240,-160 h480 v-80 H240 v80 Z" />
    </group>
</vector>
