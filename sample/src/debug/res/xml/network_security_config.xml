<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The test server uses a self-signed certificate that this machine created, so
     the debug build trusts that one file in addition to the system certificates. The release build
     has no network security config and trusts the system certificates alone. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/test_server" />
        </trust-anchors>
    </base-config>
</network-security-config>
