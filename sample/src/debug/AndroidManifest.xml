<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 17 blocks an app that targets it from private network addresses, such as the
         10.0.2.2 of the emulator or a LAN address, unless it holds this permission. Only the debug
         build talks to a developer machine, so only the debug manifest declares it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Only the debug manifest names the config, so the release manifest merges without one. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
