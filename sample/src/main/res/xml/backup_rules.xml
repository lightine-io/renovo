<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: same reasoning as data_extraction_rules.xml, which covers Android 12 and later. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
